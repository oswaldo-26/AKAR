offset_right = 30.0
offset_bottom = 20.0
location_id = "cathedral church"
location_name = "Epiphany of Our Lord Co-Cathedral Parish"
description = "In the heart of Lingayen stands a church shaped by centuries of faith, conflict, and community resilience. Historically known as Los Tres Reyes, its story reaches back to Catholic missionary activity during the Spanish colonial period. Explore its distinctive tower, historic bells, and enduring role as a co-cathedral of faith and heritage."
location_image = ExtResource("8_uecm2")
exterior_scene_path = "res://Scenes/ExteriorScenes/ChurchExterior.tscn"

